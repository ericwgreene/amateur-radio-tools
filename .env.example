# Copy to `.env` and fill in. Every value has a sensible default except the Auth0
# credentials; the app runs fine with authentication disabled if those are left blank.

# ---- Server ----
BIND_ADDRESS=127.0.0.1:8080
# Public base URL. Used to build the OAuth callback + logout return URLs, so it MUST match
# what you register in Auth0. In production this is your real origin, e.g. https://tools.example.com
BASE_URL=http://localhost:8080

# ---- Session cookie ----
# 64+ byte secret used to encrypt/sign the session cookie.
# Generate one with:  openssl rand -hex 64
# If left blank, an ephemeral key is generated at startup (fine for dev; every restart
# invalidates existing sessions).
SESSION_SECRET=
# Set to true when serving over HTTPS (the cookie is marked Secure and won't be sent over http).
COOKIE_SECURE=false

# ---- Database (SeaORM) ----
# SQLite (default). The parent directory is created automatically.
DATABASE_URL=sqlite://./data/amateur_radio_tools.db?mode=rwc
# PostgreSQL: enable the `sqlx-postgres` feature (see README > Swapping to PostgreSQL) and use:
# DATABASE_URL=postgres://user:password@localhost:5432/amateur_radio_tools

# ---- Auth0 (optional; leave blank to run with authentication disabled) ----
# Tenant domain, no scheme, e.g. dev-abc123.us.auth0.com
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# Namespaced custom ID-token claim that carries the user's roles (see README > Authorization).
AUTH0_ROLES_CLAIM=https://amateur-radio-tools/roles

# ---- Static assets ----
# Directory served at /static. Point this at the built assets in production.
STATIC_DIR=crates/web/static

# ---- Logging ----
# RUST_LOG=info,web=debug
